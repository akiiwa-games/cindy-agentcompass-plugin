+// Regression: real Windows plugin cancel waited for an active command to finish its writes.
+// Unit tier: invoke the production adapter, retaining unrelated queued input and pending run state.
+it('interrupts an owned active tool without waiting for a graceful safe point', async () => {
+  const f=fixture(),run=await f.send();
+  let commandActive=true;
+  const pending=[{clientId:run.inputMessageId},{clientId:'human-input'}];
+  const snapshot={};
+  const deps={assertPlugin:()=>{},assertCurrent:()=>{},snapshot,
+    getCurrentDbClientSnapshot:()=>snapshot,isPluginTaskAuthorized:()=>true,
+    pluginTaskServiceForCurrentOwner:()=>f.service,PluginTaskError,
+    inputCoordinator:{ensureQueueRestored:async()=>{},isQueueRestored:()=>true,
+      getQueueControlSnapshot:()=>({pendingQueue:[...pending]}),
+      remove:(_id:string,id:string)=>{pending.splice(pending.findIndex(p=>p.clientId===id),1);}},
+    withdrawOwnedSessionInputs,controlOwnedSessionExecution,isSameSessionExecution,
+    awaitAgentInputQueueSnapshotPersistence:async()=>{},
+    withSessionRestartLock:async(_id:string,operation:()=>Promise<void>)=>operation(),
+    readExecution:()=>f.execution,resetAutomaticRecoveryForExplicitStop:()=>{},contextOverflowRolloverHolder:null,
+    maker:{getSession:()=>({abort:async()=>{commandActive=false;}})},
+    sessionControlService:{stopSessionTurn:async()=>({ok:true,status:'waiting-for-safe-point'})}};
+  const source=readFileSync(new URL('../register.ts',import.meta.url),'utf8');
+  const start=source.indexOf('      cancel: async (pluginId, taskId, inputClientIds, execution) => {');
+  const block=source.slice(start+'      cancel: '.length,source.indexOf('\n      },',start)+8);
+  const js=ts.transpileModule('return ('+block+');',{compilerOptions:{target:ts.ScriptTarget.ES2022}}).outputText;
+  const cancel=new Function(...Object.keys(deps),js)(...Object.values(deps));
+  expect(await cancel('p',run.taskId,[run.inputMessageId],f.execution)).toBe('stopping');
+  expect(commandActive).toBe(false);
+  expect(pending).toEqual([{clientId:'human-input'}]);
+});
